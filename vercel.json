    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    },
    {
     "key": "Service-Worker-Allowed",
     "value": "/"
    }
   ]
  },
  {
   "source": "/manifest.webmanifest",
